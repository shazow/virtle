#!/usr/bin/env bash

set -euo pipefail

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
generated="$root/release.nix"
version="${1:-}"

if (( $# > 1 )); then
  echo "usage: $0 [version]" >&2
  echo "  version is 1.2.3 for a release commit or 1.2.3-dev for development; the current value is kept when omitted" >&2
  exit 2
fi

if [[ -z "$version" ]]; then
  version="$(sed -n 's/^  version = "\([^"]*\)";$/\1/p' "$generated")"
fi
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-dev)?$ ]]; then
  echo "Version must look like 1.2.3 or 1.2.3-dev; got: $version" >&2
  exit 2
fi

build_log="$(mktemp "$root/.update-release-nix.log.XXXXXX")"
backup="$(mktemp "$root/.update-release-nix.backup.XXXXXX")"
cp "$generated" "$backup"
updated=false
cleanup() {
  if [[ "$updated" != true ]]; then
    cp "$backup" "$generated"
  fi
  rm -f "$backup" "$build_log"
}
trap cleanup EXIT

write_package() {
  printf '%s\n' \
    '# Code generated by scripts/update-release-nix; DO NOT EDIT.' \
    '{' \
    "  version = \"$version\";" \
    "  vendorHash = \"$1\";" \
    '}' > "$generated"
}

fake_hash=sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
write_package "$fake_hash"
if nix build "$root#virtle.goModules" --no-link > "$build_log" 2>&1; then
  cat "$build_log"
  echo "Vendor build unexpectedly accepted the fake hash" >&2
  exit 1
fi
cat "$build_log"

vendor_hash="$(sed -n 's/^[[:space:]]*got:[[:space:]]*//p' "$build_log" | tail -n 1)"
if [[ ! "$vendor_hash" =~ ^sha256-[A-Za-z0-9+/]+=*$ ]]; then
  echo "Could not extract vendor hash from Nix build output" >&2
  exit 1
fi

write_package "$vendor_hash"
nix build "$root#virtle.goModules" --no-link
updated=true
