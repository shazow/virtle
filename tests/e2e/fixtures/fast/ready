#!/bin/sh
set -eu
read -r value < /input
echo "$((value * 2))" > /tmp/result
read -r result < /tmp/result
test "$result" = 42
# A disk other than the root device is a scratch volume: leave the result on
# it for the host to read back after the guest exits.
root=$(sed -n 's/.*root=\/dev\/\([a-z]*\).*/\1/p' /proc/cmdline)
for dev in /sys/block/vd*; do
  [ -e "$dev" ] || continue
  name=${dev##*/}
  [ "$name" = "$root" ] && continue
  mount -t ext4 "/dev/$name" /mnt
  echo "$result" > /mnt/result
  umount /mnt
  break
done
# A NIC is the virtle network: take its lease, report the address, serve a
# TCP echo on port 7, and probe two names when the command line asks for it
# (virtle.egress=PORT), so the host can see its policy decide by name.
if [ -e /sys/class/net/eth0 ]; then
  ifconfig lo up
  udhcpc -i eth0 -n -q -s /bin/dhcp-bound >/dev/null 2>&1 || true
  ip=none
  [ -r /tmp/ip ] && read -r ip < /tmp/ip
  echo "VIRTLE_NET:$ip"
  tcpsvd -E 0.0.0.0 7 cat &
  port=$(sed -n 's/.*virtle\.egress=\([0-9]*\).*/\1/p' /proc/cmdline)
  if [ -n "$port" ]; then
    allowed=$(echo ping | nc -w 5 allowed.test "$port" 2>/dev/null || true)
    blocked=refused
    if echo ping | nc -w 5 blocked.test "$port" >/dev/null 2>&1; then
      blocked=open
    fi
    echo "VIRTLE_EGRESS:allowed=$allowed,blocked=$blocked"
  fi
fi
echo "VIRTLE_READY:$result"
